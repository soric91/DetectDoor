# Copiar a .env y completar. El .env real no se sube al repo.
#   cp .env.example .env

# --- Telegram (obligatorio) ---
# Token del bot que da @BotFather
TOKEN_TELEGRAM=123456789:AA...
# Id del chat donde llegan las alertas. Para obtenerlo: escribile al bot y abri
# https://api.telegram.org/bot<TOKEN>/getUpdates
CHAT_ID=000000000

# --- Camara ---
RTSP_URL=rtsp://localhost:8554/frente
FRAME_WIDTH=640
FRAME_HEIGHT=360
# Opcional: pipeline GStreamer para decodificar H264 con la VPU del i.MX8 en vez
# de la CPU. Verificar antes con: gst-inspect-1.0 v4l2h264dec
# CAPTURE_PIPELINE=rtspsrc location=rtsp://localhost:8554/frente latency=100 ! rtph264depay ! h264parse ! v4l2h264dec ! videoconvert ! video/x-raw,format=BGR ! appsink drop=true max-buffers=1

# --- Recuadro de la puerta ---
# Coordenadas en pixeles sobre el frame ya redimensionado a FRAME_WIDTH x FRAME_HEIGHT
ROI_X=440
ROI_Y=80
ROI_W=120
ROI_H=230
# Margen extra al recortar, para no cortar el cuerpo de quien esta en el borde
ROI_PAD=0.25

# --- Modelo ---
# Hay tres exportados: _160 (mas rapido, menos preciso), _192 (equilibrado),
# _256 (mas preciso, mas lento). IMGSZ debe coincidir con el directorio.
NCNN_MODEL_DIR=yolo11n_ncnn_192
IMGSZ=192
NCNN_THREADS=4
YOLO_CONF=0.4
NMS_IOU=0.45

# --- Logica de alerta ---
# Segundos que la persona debe quedarse en la puerta antes de avisar
DWELL_SECONDS=3
# Segundos entre analisis (0 = tan rapido como pueda el equipo)
ANALYSIS_INTERVAL=1
# Segundos sin ver a alguien antes de olvidarlo. Debe superar el gap real entre
# analisis (ANALYSIS_INTERVAL + latencia), si no la misma persona re-alerta.
TRACK_TTL=5
# IoU minimo para considerar que dos cajas son la misma persona
IOU_MATCH=0.3
# Fraccion del cuerpo que debe caer dentro del recuadro
OVERLAP_MIN=0.35

# --- Gate de movimiento ---
# Si nada cambia en el recuadro, no se corre el detector.
MOTION_ENABLED=true
# Fraccion de pixeles que deben cambiar para despertar el detector
MOTION_AREA=0.01
# Diferencia de intensidad que cuenta como cambio (0-255)
MOTION_DELTA=25
# Segundos que se sigue analizando tras el ultimo movimiento
MOTION_HOLD=3

# --- Otros ---
# Nivel de log: DEBUG, INFO, WARNING, ERROR.
# DEBUG agrega la latencia de cada analisis y los ids detectados.
LOG_LEVEL=INFO
# true solo en equipos con escritorio, para calibrar el recuadro
SHOW_VIDEO=false
RECONNECT_SECONDS=5
MENSAJE_ALERTA=🚪 Hay alguien en la puerta
